{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenWindows package index",
  "type": "object",
  "required": ["schemaVersion", "packages"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "version", "architecture", "apiLevel", "release", "sha256", "signature"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
          "version": { "type": "string", "minLength": 1, "pattern": "^\\S+$" },
          "architecture": { "type": "string", "enum": ["amd64", "x86"] },
          "apiLevel": { "type": "integer", "minimum": 1 },
          "release": { "type": "string", "format": "uri" },
          "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
          "signature": { "type": "string", "format": "uri" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
